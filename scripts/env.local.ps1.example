# 复制本文件为 scripts/env.local.ps1 并填写本地敏感配置（该文件已 gitignore，不会入库）
$env:DEEPSEEK_ENABLED = 'true'
$env:DEEPSEEK_API_KEY = 'sk-你的key'
$env:AUDIT_MQ_URL = 'amqp://huizhitong:huizhitong@localhost:5672'
$env:TICKET_MYSQL_HOST = 'localhost'
$env:TICKET_MYSQL_PORT = '3306'
$env:TICKET_MYSQL_USER = 'root'
$env:TICKET_MYSQL_PASSWORD = '你的MySQL密码'
$env:TICKET_MYSQL_DATABASE = 'huizhitong'
$env:EMBEDDING_MODEL_PATH = 'E:/develop/Embedding/bge-m3'
$env:RERANKER_MODEL_PATH = 'E:/develop/Embedding/bge-reranker-large'
$env:RAG_DEVICE = 'cpu'
$env:RAG_VECTOR_STORE = 'milvus'
$env:MILVUS_URI = 'http://localhost:19530'
$env:LLM_PROVIDER = 'deepseek'
$env:LLM_FALLBACK = 'true'
$env:QWEN_API_KEY = ''
$env:QWEN_MODEL = 'qwen-plus'

# JWT 鉴权（网关与工具服务共享同一密钥，至少 32 字符）
$env:JWT_SECRET = 'huizhitong-dev-jwt-secret-change-me-2026'
$env:ADMIN_USERNAME = 'admin'
$env:ADMIN_INIT_PASSWORD = 'admin123'
# Java 服务统一使用 MYSQL_PASSWORD（未设置时脚本会从 TICKET_MYSQL_PASSWORD 复制）
$env:MYSQL_PASSWORD = '你的MySQL密码'