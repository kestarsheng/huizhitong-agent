# ===== 复制本文件为 deploy/.env 并填写（.env 已被 gitignore）=====

# 大模型 API Key：DeepSeek 主用；通义千问可选，做故障降级
DEEPSEEK_API_KEY=sk-你的key
QWEN_API_KEY=

# MySQL 容器（宿主访问端口 3307，内部 3306）
MYSQL_ROOT_PASSWORD=henu
MYSQL_PASSWORD=hzt123456

# JWT 签名密钥（至少 32 字符，网关与工具服务共享）与初始管理员密码
JWT_SECRET=huizhitong-docker-jwt-secret-change-me-2026
ADMIN_INIT_PASSWORD=admin123

# 复用宿主机 MySQL 时（docker-compose.host.yml）使用的 root 密码`nMYSQL_HOST_PASSWORD=henu`n`n# RAG 本地 BGE 模型目录（宿主机路径，只读挂载进容器）
EMBEDDING_MODEL_DIR=E:/develop/Embedding

# RAG 向量存储：memory（默认，零依赖）| milvus（需自建 Milvus 服务）
RAG_VECTOR_STORE=memory