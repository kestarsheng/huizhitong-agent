# ===== RAG 本地模型 =====
EMBEDDING_MODEL_PATH=E:/develop/Embedding/bge-m3
RERANKER_MODEL_PATH=E:/develop/Embedding/bge-reranker-large
RAG_DEVICE=cpu
RAG_RERANK_TOP_K=5

# ===== RAG 向量存储 =====
# auto：Milvus 可用时自动启用，不可用时降级内存索引（默认）
# milvus：强制优先 Milvus，失败仍降级内存索引
# memory：仅使用内存向量索引
RAG_VECTOR_STORE=auto
MILVUS_URI=http://localhost:19530
MILVUS_COLLECTION=hzt_knowledge_chunks
MILVUS_DIM=1024

# ===== 工单 MCP 存储：sqlite（默认）或 mysql =====
TICKET_STORAGE=mysql
TICKET_MYSQL_HOST=127.0.0.1
TICKET_MYSQL_PORT=3306
TICKET_MYSQL_USER=root
# 请勿提交真实密码，仅在本机环境或 .env 中使用
TICKET_MYSQL_PASSWORD=your-password
TICKET_MYSQL_DATABASE=huizhitong
# ===== Agent 编排 Checkpoint：memory（默认）| postgres | auto =====
# postgres/auto 需要配置 PG_DSN；连接失败自动降级 MemorySaver
AGENT_CHECKPOINT=memory
PG_DSN=postgresql://postgres:postgres@localhost:5432/huizhitong_agent
# ===== 调用审计：RabbitMQ 异步（可选）+ MySQL 持久化 =====
# 配置 AUDIT_MQ_URL 并安装 pika 后，审计记录先发 RabbitMQ，由 worker 异步入库；
# 未配置或 MQ 不可用时自动降级直写 MySQL（复用 TICKET_MYSQL_* 配置）。
AUDIT_MQ_URL=
# AUDIT_MYSQL_HOST=127.0.0.1
# AUDIT_MYSQL_PORT=3306
# AUDIT_MYSQL_USER=root
# AUDIT_MYSQL_PASSWORD=your-password
# AUDIT_MYSQL_DATABASE=huizhitong